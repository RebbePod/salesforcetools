<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>Set_Error</name>
        <label>Set Error</label>
        <locationX>514</locationX>
        <locationY>146</locationY>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Outputs</name>
        <label>Set Outputs</label>
        <locationX>901</locationX>
        <locationY>337</locationY>
        <assignmentItems>
            <assignToReference>varPicklistValueInfoCollection</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Picklist_Value_Infos</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PicklistValuesTextCollection</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Transform_To_Text_Collection</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ValuesSemicolonSeparated</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaValuesSemicolonSeparated</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <description>removes the __c if entered</description>
        <name>formulaFieldApiName</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!FieldApiName}, &quot;__c&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <description>Converts collection to flattened variable</description>
        <name>formulaValuesSemicolonSeparated</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!Transform_To_Text_Collection},
 &quot;[&quot;, &quot;&quot;),
 &quot;]&quot;, &quot;&quot;),
 &quot;,&quot;, &quot;;&quot;)</expression>
    </formulas>
    <interviewLabel>Tool - Get Picklist Values {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Tool - Get Picklist Values</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Entity_Definition</name>
        <label>Get Entity Definition</label>
        <locationX>372</locationX>
        <locationY>337</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Field_Definition</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QualifiedApiName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ObjectApiName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EntityDefinition</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Field_Definition</name>
        <label>Get Field Definition</label>
        <locationX>511</locationX>
        <locationY>337</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Picklist_Value_Infos</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EntityDefinitionId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Entity_Definition.DurableId</elementReference>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>formulaFieldApiName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>FieldDefinition</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Picklist_Value_Infos</name>
        <label>Get Picklist Value Infos</label>
        <locationX>645</locationX>
        <locationY>337</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Transform_To_Text_Collection</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EntityParticleId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Field_Definition.DurableId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PicklistValueInfo</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>26</locationX>
        <locationY>318</locationY>
        <connector>
            <targetReference>Get_Entity_Definition</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <transforms>
        <name>Transform_To_Text_Collection</name>
        <label>Transform To Text Collection</label>
        <locationX>779</locationX>
        <locationY>337</locationY>
        <connector>
            <targetReference>Set_Outputs</targetReference>
        </connector>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <transformType>Map</transformType>
                <value>
                    <elementReference>Get_Picklist_Value_Infos[$EachItem].Value</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <variables>
        <description>Flow Error Message</description>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Field Api Name, Case sensitive</description>
        <name>FieldApiName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Object Api Name, Case sensitive</description>
        <name>ObjectApiName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Picklist Values Text Collection</description>
        <name>PicklistValuesTextCollection</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Values Semicolon Separated, used to default picklists with values</description>
        <name>ValuesSemicolonSeparated</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varPicklistValueInfoCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>PicklistValueInfo</objectType>
    </variables>
</Flow>
